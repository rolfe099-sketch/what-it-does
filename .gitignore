# Dependencies and build output
node_modules/
dist/
*.tgz

# Cloned repos used as scan targets — not ours to commit.
# Leading slash matters: an unanchored "fixtures/" would also ignore
# tests/fixtures/, which we very much do want tracked.
/fixtures/

# Scan history written into fixtures by the test suite
**/.what-it-does/

# Generated reports. demo/ is the hosted sample — regenerate with `npm run demo`
# rather than committing 1.6MB of generated HTML into the source history.
demo/
what-it-does-report.html
eriksen-report.html
report-*.html

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/
