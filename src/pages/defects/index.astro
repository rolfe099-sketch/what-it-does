---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fixesForDefect, formatDate } from '../../lib/data';

const defects = (await getCollection('defects')).sort(
  (a, b) => a.data.commonness - b.data.commonness,
);

const severityLabel = {
  cosmetic: 'Cosmetic',
  structural: 'Structural',
  'print-ending': 'Print-ending',
} as const;
---

<Base
  title="Every defect"
  description="Every 3D printing defect in the database, ordered by how often it comes up, each with ordered fixes and the reasoning behind them."
>
  <div class="canvas">

    <section class="spread">
      <div class="stack-md">
        <p class="eyebrow">Reference</p>
        <h1 class="title">Every defect, ordered by how often it bites</h1>
        <p class="lead">
          If you already know what you are looking at, go straight to it. If you
          do not, the <a href="/fix/">diagnostic</a> will narrow it down from
          symptoms.
        </p>
      </div>

      <aside class="rail">
        <div class="note">
          <span class="note__label">In the database</span>
          <dl>
            <dt>Defects</dt><dd>{defects.length}</dd>
            <dt>Ordering</dt><dd>By frequency</dd>
          </dl>
        </div>
        <div class="note note--caveat">
          <span class="note__label">Deliberately short</span>
          This list covers the defects that account for most failures. It grows
          when there is something real to add, not to fill a page count.
        </div>
      </aside>
    </section>

    <div class="tick-rule" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

    <section class="spread">
      <div>
        <ul class="study-list">
          {defects.map((defect) => (
            <li class="study-item">
              <p class="study-item__meta">
                <span>{severityLabel[defect.data.severity]}</span>
                <span>{fixesForDefect(defect.id).length} fixes</span>
                <span>Reviewed {formatDate(defect.data.updated)}</span>
              </p>
              <h2 class="study-item__title">
                <a href={`/defects/${defect.id}/`}>{defect.data.title}</a>
              </h2>
              <p class="study-item__summary">{defect.data.summary}</p>
              {defect.data.alsoKnownAs.length > 0 && (
                <p class="defect-aka">Also called {defect.data.alsoKnownAs.join(', ')}.</p>
              )}
            </li>
          ))}
        </ul>
      </div>

      <aside class="rail">
        <div class="note">
          <span class="note__label">Not here?</span>
          The database is new. If you are looking at something this list does
          not cover, <a href="/contribute/">tell us what it was</a> — that is how
          the next entry gets written.
        </div>
      </aside>
    </section>

  </div>
</Base>

<style>
  .defect-aka {
    margin-top: var(--space-2);
    font-size: var(--size-xs);
    color: var(--ink-faint);
  }
</style>
