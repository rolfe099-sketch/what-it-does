---
import { SITE, FOOTER } from '../site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="canvas">
    <div class="site-footer__cols">
      {FOOTER.map((group) => (
        <div>
          <h2>{group.heading}</h2>
          <ul>
            {group.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="site-footer__legal">
      <p>
        Settings data on {SITE.name} is published under
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>
        — use it, with a link back. Every recommendation shows how many results it
        rests on, because a number without its sample size is not a measurement.
      </p>
      <p>
        © {year} {SITE.operator.name} ({SITE.operator.legalName}, org.
        {' '}{SITE.operator.orgNumber}), {SITE.operator.country}.
        This site sets no advertising or tracking cookies.
        <a href="/disclosure/">Advertising &amp; affiliate disclosure</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer__legal p + p { margin-top: var(--space-3); }
</style>
