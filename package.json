{
  "name": "what-it-does",
  "version": "0.1.0",
  "description": "Shows you what software you didn't write actually does, and tells you when that changes. Runs locally; your code never leaves the machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "what-it-does": "dist/cli.js"
  },
  "files": [
    "dist",
    "design/fonts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "static-analysis",
    "nextjs",
    "codebase",
    "documentation",
    "dependency-graph"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && npm test",
    "scan": "tsx src/cli.ts scan",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
